[Unit]
Description=Bot de Sessão de Treino (Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=treinobot
WorkingDirectory=/opt/treino-bot
ExecStart=/opt/treino-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
